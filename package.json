{
  "name": "leave-management-system",
  "version": "1.0.0",
  "description": "Government Department Leave Management System",
  "main": "src/main/main.js",
  "scripts": {
    "postinstall": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime=electron --target=22.3.27",
    "start": "electron .",
    "dev": "electron . --inspect=5858",
    "db:reset": "node scripts/reset-db.js",
    "dev:clean": "npm run db:reset && npm run dev",
    "test": "node tests/ipcChannelGuard.test.js && node tests/employeeAutoId.test.js && node tests/workShiftType.test.js && node tests/leaveService.test.js && node tests/freshInstall.test.js && node tests/dossierNumber.test.js && node tests/excelNumericFormatting.test.js && node tests/dossierUniqueness.test.js && node tests/dossierNumberDbConstraint.test.js && node tests/zipSlipProtection.test.js && node tests/systemOpenPathSecurity.test.js && node tests/migrationUpgradeCompat.test.js && node tests/loggerServicePiiRedaction.test.js && node tests/reportService.test.js && node tests/leaveTypeService.test.js && node tests/systemSafetyAndStartup.test.js",
    "build": "electron-builder --win"
  },
  "keywords": [],
  "author": "Eng Sajjad Nadhim",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "adm-zip": "^0.6.0",
    "better-sqlite3": "8.7.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.hr.holidays",
    "productName": "Holidays",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      "!scripts",
      "!scratch",
      "!backups",
      "!data",
      "!tests",
      "!*.db*",
      "!temp_*",
      "!*.txt",
      "!*.log"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true,
      "shortcutName": "نظام الإجازات",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "appx": {
      "identityName": "EngSajjadNadhim.Holidays",
      "publisher": "CN=F436D457-FA45-4B3F-835F-43A6DF79C56C",
      "publisherDisplayName": "Eng Sajjad Nadhim",
      "displayName": "نظام الإجازات | Holidays",
      "applicationId": "Holidays",
      "languages": [
        "ar-IQ",
        "en-US"
      ]
    }
  },
  "copyright": "Copyright © 2026 Eng Sajjad Nadhim"
}